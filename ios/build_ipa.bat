@echo offtitle Stealth Pool IPA Buildercolor 0Cecho.echo ============================================echo    STEALTH POOL iOS IPA BUILDER v2.0echo    by xpe.nettt / Stealth Proyectecho ============================================echo.python --version >nul 2>&1if errorlevel 1 (    echo [ERROR] Python no encontrado. Instala Python 3.8+    pause & exit /b 1)if not exist "*.ipa" (    echo [ERROR] Coloca el IPA original de 8 Ball Pool en esta carpeta    echo.    echo Como obtenerlo:    echo   1. Conecta tu iPhone al PC    echo   2. Abre Sideloadly    echo   3. Selecciona "Download from device"    echo   4. Elige 8 Ball Pool    pause & exit /b 1)if not exist "FridaGadget.dylib" (    echo [1/3] Descargando FridaGadget...    python ipa_builder.py --download    if errorlevel 1 (        echo [ERROR] Descarga manual:        echo https://github.com/frida/frida/releases/download/16.2.1/frida-gadget-16.2.1-ios-universal.dylib        pause & exit /b 1    )) else ( echo [1/3] FridaGadget OK )if not exist "stealth_ios.js" ( echo [ERROR] Falta stealth_ios.js & pause & exit /b 1 )echo [2/3] Script verificadoecho [3/3] Construyendo IPA...python ipa_builder.pyif errorlevel 1 ( echo [ERROR] Fallo & pause & exit /b 1 )echo.echo ============================================echo    LISTO! 8BallPool-Stealth.ipa generadoecho ============================================echo.echo   1. Arrastrar IPA a Sideloadlyecho   2. Apple ID -> Startecho   3. En iPhone: Confiar perfil developerecho   4. Tocar 3x logo Miniclip -> ingresar keyecho.pause